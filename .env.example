## Portfolio admin dashboard (Supabase)
## Powers /admin — adding/editing "Our Work" projects without a code deploy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

## Sanity (optional)
## If you enable Sanity, set these in Vercel/host environment variables.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-01-01

## Contact form email (recommended for production)
## Email sending uses Resend. If empty, form still returns success but won't email.
RESEND_API_KEY=
LEADS_FROM_EMAIL=PixelPulse <onboarding@resend.dev>
LEADS_TO_EMAIL=

## Rate limit settings (optional)
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
CONTACT_RATE_LIMIT_MAX=6

## Analytics (optional — scripts load only when IDs are set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
